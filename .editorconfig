root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[{*.js,*.mjs,*.md,*.json,*.toml,*.yml,*.yaml,*.sh}]
indent_size = 2

# Continuation lines of numbered lists need 3 spaces.
[*.md]
indent_size = unset
